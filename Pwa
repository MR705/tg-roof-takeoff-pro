import React, { useRef, useState, useEffect } from "react";

export default function Trace() {
  const canvasRef = useRef(null);
  const imgRef = useRef(null);

  const [image, setImage] = useState(null);

  const [scalePoints, setScalePoints] = useState([]);
  const [scaleFeet, setScaleFeet] = useState("");
  const [pixelsPerFoot, setPixelsPerFoot] = useState(null);

  const [mode, setMode] = useState("scale"); // "scale" | "trace"
  const [pitch, setPitch] = useState("6"); // 6/12 default

  const [currentPolygon, setCurrentPolygon] = useState([]);
  const [sections, setSections] = useState([]); // {id, points, planArea, roofArea, squares}

  // ---------- IMAGE UPLOAD ----------

  function handleUpload(e) {
    const file = e.target.files[0];
    if (!file) return;
    const url = URL.createObjectURL(file);

    const img = new Image();
    img.onload = () => {
      imgRef.current = img;
      setImage(url);
      resetAll();
      draw();
    };
    img.src = url;
  }

  function resetAll() {
    setScalePoints([]);
    setScaleFeet("");
    setPixelsPerFoot(null);
    setMode("scale");
    setCurrentPolygon([]);
    setSections([]);
  }

  // ---------- CANVAS CLICK HANDLING ----------

  function handleCanvasClick(e) {
    const canvas = canvasRef.current;
    if (!canvas) return;
    const rect = canvas.getBoundingClientRect();
    const x = e.clientX - rect.left;
    const y = e.clientY - rect.top;

    if (mode === "scale") {
      handleScaleClick({ x, y });
    } else if (mode === "trace") {
      handleTraceClick({ x, y });
    }
  }

  // ---------- SCALE LOGIC ----------

  function handleScaleClick(pt) {
    if (scalePoints.length === 0) {
      setScalePoints([pt]);
    } else if (scalePoints.length === 1) {
      const pts = [scalePoints[0], pt];
      setScalePoints(pts);

      const feet = parseFloat(scaleFeet);
      if (feet > 0) computePixelsPerFoot(pts, feet);
    } else {
      // third click resets scale
      setScalePoints([pt]);
      setPixelsPerFoot(null);
    }
  }

  function computePixelsPerFoot(pts, feet) {
    const [p1, p2] = pts;
    const dx = p1.x - p2.x;
    const dy = p1.y - p2.y;
    const pixelDist = Math.sqrt(dx * dx + dy * dy);
    setPixelsPerFoot(pixelDist / feet);
  }

  function handleScaleFeetChange(e) {
    const val = e.target.value;
    setScaleFeet(val);
    const feet = parseFloat(val);
    if (scalePoints.length === 2 && feet > 0) {
      computePixelsPerFoot(scalePoints, feet);
    }
  }

  // ---------- TRACE / SECTIONS LOGIC ----------

  function handleTraceClick(pt) {
    // If near first point, close polygon and create section
    if (currentPolygon.length >= 3) {
      const first = currentPolygon[0];
      const dx = pt.x - first.x;
      const dy = pt.y - first.y;
      const dist = Math.sqrt(dx * dx + dy * dy);
      if (dist < 10) {
        addSectionFromPolygon(currentPolygon);
        setCurrentPolygon([]);
        return;
      }
    }
    setCurrentPolygon([...currentPolygon, pt]);
  }

  function addSectionFromPolygon(points) {
    if (!pixelsPerFoot || points.length < 3) return;

    const { planArea, roofArea, squares } = computeSectionMetrics(points);

    const id = sections.length + 1;
    const newSection = {
      id,
      points,
      planArea,
      roofArea,
      squares,
    };

    setSections([...sections, newSection]);
  }

  function computeSectionMetrics(points) {
    // Shoelace formula in pixels
    let areaPixels = 0;
    for (let i = 0; i < points.length; i++) {
      const { x: x1, y: y1 } = points[i];
      const { x: x2, y: y2 } = points[(i + 1) % points.length];
      areaPixels += x1 * y2 - x2 * y1;
    }
    areaPixels = Math.abs(areaPixels) / 2;

    const feetPerPixel = 1 / pixelsPerFoot;
    const planArea = areaPixels * feetPerPixel * feetPerPixel;

    const pitchVal = parseFloat(pitch) || 0;
    const pitchMultiplier = Math.sqrt(1 + (pitchVal / 12) ** 2);
    const roofArea = planArea * pitchMultiplier;
    const squares = roofArea / 100;

    return { planArea, roofArea, squares };
  }

  function clearCurrentPolygon() {
    setCurrentPolygon([]);
  }

  function clearAllSections() {
    setSections([]);
    setCurrentPolygon([]);
  }

  // ---------- DRAWING ----------

  function draw() {
    const canvas = canvasRef.current;
    const img = imgRef.current;
    if (!canvas || !img) return;

    const ctx = canvas.getContext("2d");
    const w = canvas.width;
    const h = canvas.height;

    ctx.clearRect(0, 0, w, h);
    ctx.fillStyle = "#111";
    ctx.fillRect(0, 0, w, h);

    // Fit image
    const scale = Math.min(w / img.width, h / img.height);
    const imgW = img.width * scale;
    const imgH = img.height * scale;
    const offsetX = (w - imgW) / 2;
    const offsetY = (h - imgH) / 2;

    ctx.drawImage(img, offsetX, offsetY, imgW, imgH);

    // Scale line
    if (scalePoints.length > 0) {
      ctx.strokeStyle = "#00ff88";
      ctx.fillStyle = "#00ff88";
      ctx.lineWidth = 2;

      scalePoints.forEach((p) => {
        ctx.beginPath();
        ctx.arc(p.x, p.y, 4, 0, Math.PI * 2);
        ctx.fill();
      });

      if (scalePoints.length === 2) {
        ctx.beginPath();
        ctx.moveTo(scalePoints[0].x, scalePoints[0].y);
        ctx.lineTo(scalePoints[1].x, scalePoints[1].y);
        ctx.stroke();
      }
    }

    // Existing sections
    sections.forEach((section) => {
      const pts = section.points;
      if (pts.length === 0) return;

      ctx.strokeStyle = "#ffcc00";
      ctx.fillStyle = "rgba(255, 204, 0, 0.25)";
      ctx.lineWidth = 2;

      ctx.beginPath();
      ctx.moveTo(pts[0].x, pts[0].y);
      for (let i = 1; i < pts.length; i++) {
        ctx.lineTo(pts[i].x, pts[i].y);
      }
      ctx.closePath();
      ctx.fill();
      ctx.stroke();

      // Label section ID roughly at first point
      const first = pts[0];
      ctx.fillStyle = "#ffffff";
      ctx.font = "14px sans-serif";
      ctx.fillText(`S${section.id}`, first.x + 8, first.y - 8);
    });

    // Current polygon
    if (currentPolygon.length > 0) {
      ctx.strokeStyle = "#00aaff";
      ctx.fillStyle = "rgba(0, 170, 255, 0.2)";
      ctx.lineWidth = 2;

      ctx.beginPath();
      ctx.moveTo(currentPolygon[0].x, currentPolygon[0].y);
      for (let i = 1; i < currentPolygon.length; i++) {
        ctx.lineTo(currentPolygon[i].x, currentPolygon[i].y);
      }
      ctx.stroke();

      currentPolygon.forEach((p, idx) => {
        ctx.beginPath();
        ctx.arc(p.x, p.y, 4, 0, Math.PI * 2);
        ctx.fillStyle = "#00aaff";
        ctx.fill();

        if (idx === 0) {
          ctx.beginPath();
          ctx.arc(p.x, p.y, 7, 0, Math.PI * 2);
          ctx.strokeStyle = "#ffffff";
          ctx.stroke();
        }
      });
    }
  }

  useEffect(() => {
    draw();
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [image, scalePoints, sections, currentPolygon]);

  // ---------- TOTALS ----------

  const totals = sections.reduce(
    (acc, s) => {
      acc.plan += s.planArea;
      acc.roof += s.roofArea;
      acc.squares += s.squares;
      return acc;
    },
    { plan: 0, roof: 0, squares: 0 }
  );

  return (
    <div style={{ padding: 16, background: "#000", color: "#eee", minHeight: "100vh" }}>
      <h2>Roof Takeoff – Sections + Pitch</h2>

      {/* Upload */}
      <div style={{ marginBottom: 12 }}>
        <label>Upload roof image:</label>
        <br />
        <input type="file" accept="image/*" onChange={handleUpload} />
      </div>

      {/* Mode + Pitch */}
      <div style={{ marginBottom: 12 }}>
        <strong>Mode: </strong>
        <button
          onClick={() => setMode("scale")}
          style={{
            marginRight: 8,
            padding: "4px 8px",
            background: mode === "scale" ? "#00aa88" : "#222",
            color: "#fff",
            border: "none",
          }}
        >
          Set Scale
        </button>
        <button
          onClick={() => setMode("trace")}
          style={{
            padding: "4px 8px",
            background: mode === "trace" ? "#00aa88" : "#222",
            color: "#fff",
            border: "none",
          }}
        >
          Trace Sections
        </button>
      </div>

      <div style={{ marginBottom: 12 }}>
        <label style={{ marginRight: 8 }}>Pitch (rise / 12):</label>
        <input
          type="number"
          value={pitch}
          onChange={(e) => setPitch(e.target.value)}
          style={{ width: 80, padding: 4 }}
        />
      </div>

      {/* Scale input */}
      <div style={{ marginBottom: 12 }}>
        <div style={{ marginBottom: 4 }}>
          <strong>Scale:</strong> Click two points on a known distance (e.g., 10 ft).
        </div>
        <input
          type="number"
          placeholder="Distance in feet"
          value={scaleFeet}
          onChange={handleScaleFeetChange}
          style={{ padding: 4, width: 140, marginRight: 8 }}
        />
        {pixelsPerFoot && (
          <span style={{ fontSize: 12, color: "#aaa" }}>
            {pixelsPerFoot.toFixed(2)} px/ft
          </span>
        )}
      </div>

      {/* Buttons */}
      <div style={{ marginBottom: 12 }}>
        <button
          onClick={clearCurrentPolygon}
          style={{ padding: "4px 8px", marginRight: 8, background: "#333", color: "#fff", border: "none" }}
        >
          Clear Current Section
        </button>
        <button
          onClick={clearAllSections}
          style={{ padding: "4px 8px", background: "#552222", color: "#fff", border: "none" }}
        >
          Clear All Sections
        </button>
      </div>

      {/* Canvas */}
      <div
        style={{
          border: "1px solid #333",
          marginBottom: 12,
          maxWidth: "100%",
          overflow: "hidden",
        }}
      >
        <canvas
          ref={canvasRef}
          width={800}
          height={600}
          onClick={handleCanvasClick}
          style={{ width: "100%", touchAction: "none", background: "#111" }}
        />
      </div>

      {/* Results */}
      <div>
        <h3>Sections</h3>
        {!pixelsPerFoot && <p>Set scale to enable real area calculations.</p>}
        {pixelsPerFoot && sections.length === 0 && (
          <p>
            Trace a section: click around the roof. Click near the first point to close and save the section.
          </p>
        )}

        {sections.map((s) => (
          <div key={s.id} style={{ marginBottom: 8, borderBottom: "1px solid #333", paddingBottom: 4 }}>
            <strong>Section S{s.id}</strong>
            <div>Plan area: {s.planArea.toFixed(1)} sq ft</div>
            <div>Roof area: {s.roofArea.toFixed(1)} sq ft</div>
            <div>Squares: {s.squares.toFixed(2)}</div>
          </div>
        ))}

        {sections.length > 0 && (
          <div style={{ marginTop: 12 }}>
            <h3>Totals</h3>
            <div>Plan area: {totals.plan.toFixed(1)} sq ft</div>
            <div>Roof area: {totals.roof.toFixed(1)} sq ft</div>
            <div>Squares: {totals.squares.toFixed(2)}</div>
          </div>
        )}
      </div>
    </div>
  );
}
