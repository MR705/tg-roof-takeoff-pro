from fastapi import FastAPI
from fastapi.middleware.cors import CORSMiddleware
from pydantic import BaseModel

app = FastAPI()

# Allow PWA to connect
app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],
    allow_methods=["*"],
    allow_headers=["*"],
)

class TakeoffRequest(BaseModel):
    project_name: str
    sections: list
    pitch: float

@app.get("/")
def root():
    return {"status": "TG Roof Takeoff Pro API running"}

@app.post("/estimate")
def estimate(data: TakeoffRequest):
    total_area = sum([s["area"] for s in data.sections])
    pitch_multiplier = (1 + (data.pitch / 12) ** 2) ** 0.5
    roof_area = total_area * pitch_multiplier
    squares = roof_area / 100
    return {
        "project": data.project_name,
        "total_area": total_area,
        "roof_area": roof_area,
        "squares": squares
    }

